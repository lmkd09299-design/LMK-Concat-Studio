// SPDX-License-Identifier: AGPL-3.0-or-later
// LMK Video Studio additions to Concat, 2026.
import { Theme } from "theme/theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Button } from "primitives/modal.slint";
import { Select } from "primitives/select.slint";
import { Switch } from "inspector/controls.slint";

export struct LmkRequest {
    mode: int,
    source: string,
    subtitle: string,
    output: string,
    aspect: string,
    language: string,
    rights: string,
    voice: bool,
    burn: bool,
    mute: bool,
    minutes: int,
    analysis: string,
    replacement_audio: string,
    license_note: string,
}

export component LmkField inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    height: 62px;
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
        }
        Rectangle {
            height: 33px;
            border-radius: Theme.r-sm;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.field;
            TextInput {
                x: 8px;
                y: 5px;
                width: parent.width - 16px;
                height: parent.height - 10px;
                text <=> root.value;
                single-line: true;
                color: Theme.fg;
                font-size: Theme.fs;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
            }
        }
    }
}

export component LmkNav inherits Rectangle {
    in property <int> active;
    callback select(page: int);
    height: 41px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 8px;
        Button {
            label: "CONCAT EDITOR";
            primary: root.active == 0;
            ghost: root.active != 0;
            clicked => { root.select(0); }
        }
        Button {
            label: "BIEN TAP VIDEO";
            primary: root.active == 1;
            ghost: root.active != 1;
            clicked => { root.select(1); }
        }
        Button {
            label: "MOVIE RECAP AI";
            primary: root.active == 2;
            ghost: root.active != 2;
            clicked => { root.select(2); }
        }
        Button {
            label: "BAN QUYEN & AUDIO";
            primary: root.active == 3;
            ghost: root.active != 3;
            clicked => { root.select(3); }
        }
    }
}

export component LmkTools inherits Rectangle {
    in property <int> page;
    in property <string> job-status;
    in property <bool> busy;
    callback run-job(request: LmkRequest);
    property <string> source-path: "";
    property <string> subtitle-path: "";
    property <string> output-path: "";
    property <string> analysis-text: "";
    property <string> replacement-path: "";
    property <string> license-note: "";
    property <int> aspect-choice: 0;
    property <int> language-choice: 0;
    property <int> rights-choice: 0;
    property <bool> dubbing: false;
    property <bool> burn-subs: false;
    property <bool> mute-original: false;
    property <int> minutes-choice: 1;

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 65px;
            background: Theme.raised;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: root.page == 1 ? "VIDEO EDITOR" : (root.page == 2 ? "MOVIE RECAP FACTORY" : "COPYRIGHT REVIEW & AUDIO");
                    color: Theme.fg;
                    font-weight: 700;
                    font-size: Theme.fs-lg;
                }
                Text {
                    text: root.page == 1 ? "Dich, long tieng, bien tap video" : (root.page == 2 ? "Phan tich phim, chon canh, ghep & thuyet minh" : "Rao soat quyen, tat / thay am thanh da cap phep");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                spacing: 9px;
                LmkField { label: "Duong dan video goc"; value <=> root.source-path; }
                if root.page != 3: LmkField { label: "File phu de .srt (khong bat buoc)"; value <=> root.subtitle-path; }
                LmkField { label: "Thu muc luu thanh pham"; value <=> root.output-path; }
                if root.page != 3: Text { text: "Ty le khung hinh"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                if root.page != 3: Select {
                    options: ["9:16 (Shorts / TikTok)", "16:9 (YouTube)", "1:1 (Square)"];
                    current: root.aspect-choice;
                    changed(index) => { root.aspect-choice = index; }
                }
                if root.page != 3: Text { text: "Ngon ngu / kich ban"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                if root.page != 3: Select {
                    options: root.page == 1
                        ? ["Giu nguyen", "Tieng Viet", "English", "Thai"]
                        : ["Tieng Viet", "English", "Thai"];
                    current: root.language-choice;
                    changed(index) => { root.language-choice = index; }
                }
                if root.page == 1 || root.page == 3: VerticalLayout {
                    spacing: 6px;
                    Text { text: "Tinh trang quyen su dung (do ban xac nhan)"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                    Select {
                        options: ["Chua xac minh", "Tu quay / tu so huu", "Duoc cap phep", "Public domain / CC phu hop"];
                        current: root.rights-choice;
                        changed(index) => { root.rights-choice = index; }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Khong co cong cu nao cam ket ne Content ID / ban quyen; tab nay tao bao cao va bien tap hop le.";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                    LmkField {
                        label: "Duong dan am thanh THAY THE (khong bat buoc)";
                        value <=> root.replacement-path;
                    }
                    Text {
                        text: "Bang chung / ghi chu giay phep cho am thanh thay the";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                    }
                    Rectangle {
                        height: 78px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: Theme.r-sm;
                        TextInput {
                            x: 9px; y: 7px;
                            width: parent.width - 18px;
                            height: parent.height - 14px;
                            text <=> root.license-note;
                            color: Theme.fg;
                            single-line: false;
                            wrap: word-wrap;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Loai bo hoan toan am thanh goc";
                            color: Theme.fg;
                            horizontal-stretch: 1;
                        }
                        Switch { checked: root.mute-original; toggled(on) => { root.mute-original = on; } }
                    }
                    Text {
                        text: "Khong chon am thanh / tat am: chi xuat bao cao quyen. Co thay doi: tao MP4.";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Burn phu de len video"; color: Theme.fg; horizontal-stretch: 1; }
                        Switch { checked: root.burn-subs; toggled(on) => { root.burn-subs = on; } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Tat nhac / am thanh goc"; color: Theme.fg; horizontal-stretch: 1; }
                        Switch { checked: root.mute-original; toggled(on) => { root.mute-original = on; } }
                    }
                    Text { text: "Loi binh goc cua ban (hien thanh chu)"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                    Rectangle {
                        height: 104px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.line;
                        border-radius: Theme.r-sm;
                        TextInput {
                            x: 9px; y: 7px;
                            width: parent.width - 18px;
                            height: parent.height - 14px;
                            text <=> root.analysis-text;
                            color: Theme.fg;
                            single-line: false;
                            wrap: word-wrap;
                            selection-background-color: Theme.accent;
                            selection-foreground-color: Theme.on-accent;
                        }
                    }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Thoi luong recap"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
                    Select {
                        options: ["1 phut", "3 phut", "5 phut", "8 phut", "10 phut"];
                        current: root.minutes-choice;
                        changed(index) => { root.minutes-choice = index; }
                    }
                    Text {
                        text: "He thong tim mốc truyen, phat hien cat canh, xuat script TXT, CSV, SRT va MP4.";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
                if root.page != 3: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Tao giong doc / long tieng"; color: Theme.fg; horizontal-stretch: 1; }
                    Switch { checked: root.dubbing; toggled(on) => { root.dubbing = on; } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Text {
                    text: root.job-status;
                    color: root.busy ? Theme.accent : Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Button {
                    block: true;
                    primary: true;
                    large: true;
                    label: root.busy ? "DANG XU LY..." : (root.page == 1 ? "XUAT VIDEO" : (root.page == 2 ? "TAO MOVIE RECAP" : "RA SOAT / XUAT VIDEO"));
                    enabled: !root.busy && root.source-path != "" && root.output-path != "";
                    clicked => {
                        root.run-job({
                            mode: root.page,
                            source: root.source-path,
                            subtitle: root.subtitle-path,
                            output: root.output-path,
                            aspect: root.aspect-choice == 0 ? "9:16" : (root.aspect-choice == 1 ? "16:9" : "1:1"),
                            language: root.page == 1
                                ? (root.language-choice == 0 ? "Giữ nguyên" : (root.language-choice == 1 ? "Tiếng Việt" : (root.language-choice == 2 ? "English" : "Thai")))
                                : (root.language-choice == 0 ? "Tiếng Việt" : (root.language-choice == 1 ? "English" : "Thai")),
                            rights: root.rights-choice == 0 ? "Chưa xác minh" : (root.rights-choice == 1 ? "Tự quay / tự sở hữu" : (root.rights-choice == 2 ? "Được cấp phép" : "Public domain / CC phù hợp")),
                            voice: root.dubbing,
                            burn: root.burn-subs,
                            mute: root.mute-original,
                            minutes: root.minutes-choice == 0 ? 1 : (root.minutes-choice == 1 ? 3 : (root.minutes-choice == 2 ? 5 : (root.minutes-choice == 3 ? 8 : 10))),
                            analysis: root.analysis-text,
                            replacement_audio: root.page == 3 ? root.replacement-path : "",
                            license_note: root.page == 3 ? root.license-note : "",
                        });
                    }
                }
                Text {
                    text: "Chinh sua, dich, long tieng hay thay nhac khong tu tao quyen su dung."
                        + " Kiem tra giay phep truoc khi dang.";
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    wrap: word-wrap;
                }
            }
        }
    }
}
